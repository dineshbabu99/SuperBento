NODE_ENV=development

# Database
POSTGRES_USER=superbento
POSTGRES_PASSWORD=superbento_secret_change_in_prod
POSTGRES_DB=superbento_erp
DATABASE_URL="postgresql://superbento:superbento_secret_change_in_prod@localhost:5432/superbento_erp"

# Redis
REDIS_PASSWORD=redis_secret_change_in_prod
REDIS_URL="redis://:redis_secret_change_in_prod@localhost:6379"

# JWT — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change_me_access_secret_must_be_at_least_32_characters_long
JWT_REFRESH_SECRET=change_me_refresh_secret_must_be_at_least_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# App
APP_PORT=4000
FRONTEND_URL=http://localhost:5173

# pgAdmin
PGADMIN_EMAIL=admin@superbento.com
PGADMIN_PASSWORD=admin123

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@superbento.com
SMTP_PASS=your_smtp_password
SMTP_FROM="SuperBento ERP <noreply@superbento.com>"

# Seed super admin
SEED_ADMIN_EMAIL=superadmin@superbento.com
SEED_ADMIN_PASSWORD=SuperBento@2024!
SEED_ADMIN_FIRST_NAME=Super
SEED_ADMIN_LAST_NAME=Admin
