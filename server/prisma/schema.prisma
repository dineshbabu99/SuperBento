// Prisma Schema for SuperBento ERP
// Phase 1: Authentication, Users, Roles, Permissions, Notifications, Audit Logs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  ROLE_ASSIGNED
  PERMISSION_CHANGED
  ACTIVATED
  DEACTIVATED
  EXPORT
  IMPORT
}

enum MenuStatus {
  DRAFT
  PUBLISHED
  COMPLETED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum PrepTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  PURCHASE_RECEIPT
  KITCHEN_USAGE
  ADJUSTMENT
  WASTAGE
  RETURN
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  FAILED
}

// ─────────────────────────────────────────────────────────
// BRANCHES
// ─────────────────────────────────────────────────────────

model Branch {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  code      String    @unique
  address   String?
  city      String?
  state     String?
  pincode   String?
  phone     String?
  email     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.ObjectId
  updatedBy String?   @db.ObjectId

  users           User[]
  dailyMenus      DailyMenu[]
  inventoryItems  InventoryItem[]
  purchaseOrders  PurchaseOrder[]
  deliveryBatches DeliveryBatch[]

  @@map("branches")
}

// ─────────────────────────────────────────────────────────
// PERMISSIONS
// ─────────────────────────────────────────────────────────

model Permission {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique // e.g. "users:read"
  module      String // e.g. "users"
  action      String // e.g. "read"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

// ─────────────────────────────────────────────────────────
// ROLES
// ─────────────────────────────────────────────────────────

model Role {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  slug        String    @unique
  description String?
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?   @db.ObjectId
  updatedBy   String?   @db.ObjectId

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

// ─────────────────────────────────────────────────────────
// ROLE_PERMISSIONS (Join Table)
// ─────────────────────────────────────────────────────────

model RolePermission {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String @db.ObjectId
  permissionId String @db.ObjectId

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────────────────

model User {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  email           String     @unique
  phoneNumber     String?    @unique
  passwordHash    String
  firstName       String
  lastName        String
  avatarUrl       String?
  status          UserStatus @default(ACTIVE)
  isEmailVerified Boolean    @default(false)
  lastLoginAt     DateTime?
  roleId          String?    @db.ObjectId
  branchId        String?    @db.ObjectId
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
  createdBy       String?    @db.ObjectId
  updatedBy       String?    @db.ObjectId

  role              Role?                @relation(fields: [roleId], references: [id])
  branch            Branch?              @relation(fields: [branchId], references: [id])
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  passwordResets    PasswordResetToken[]
  auditLogs         AuditLog[]           @relation("AuditLogActor")
  assignedPrepTasks PrepTask[]           @relation("PrepTaskAssignee")
  stockMovements    StockMovement[]      @relation("StockMovementPerformer")
  purchaseOrders    PurchaseOrder[]      @relation("PurchaseOrderCreator")
  approvedPOs       PurchaseOrder[]      @relation("PurchaseOrderApprover")
  deliveryBatches   DeliveryBatch[]      @relation("DeliveryBatchAgent")
  employeeProfile   EmployeeProfile?
  transactions      Transaction[]        @relation("TransactionPerformer")

  @@index([roleId])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

// ─────────────────────────────────────────────────────────
// REFRESH TOKENS
// ─────────────────────────────────────────────────────────

model RefreshToken {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  tokenFamily String    // Used for rotation attack detection
  tokenHash   String // Stored hashed, never plain
  expiresAt   DateTime
  isRevoked   Boolean   @default(false)
  revokedAt   DateTime?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────
// PASSWORD RESET TOKENS
// ─────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────

model Notification {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  userId     String           @db.ObjectId
  title      String
  message    String
  type       NotificationType @default(INFO)
  isRead     Boolean          @default(false)
  readAt     DateTime?
  entityType String?
  entityId   String?          @db.ObjectId
  actionUrl  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────────────────

model AuditLog {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?     @db.ObjectId
  action    AuditAction
  entity    String
  entityId  String?     @db.ObjectId
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime    @default(now())

  actor User? @relation("AuditLogActor", fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────
// INGREDIENTS
// ─────────────────────────────────────────────────────────

model Ingredient {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  unit        String // e.g. kg, g, L, pcs
  defaultCost Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  recipes            RecipeIngredient[]
  inventoryItems     InventoryItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@map("ingredients")
}

// ─────────────────────────────────────────────────────────
// RECIPES
// ─────────────────────────────────────────────────────────

model Recipe {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String?
  instructions    String?
  prepTimeMinutes Int?
  cookTimeMinutes Int?
  category        String?
  nutritionalInfo Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  ingredients RecipeIngredient[]
  menuItems   MenuItem[]

  @@map("recipes")
}

// ─────────────────────────────────────────────────────────
// RECIPE INGREDIENTS (Join Table)
// ─────────────────────────────────────────────────────────

model RecipeIngredient {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  recipeId     String @db.ObjectId
  ingredientId String @db.ObjectId
  quantity     Float
  unit         String

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

// ─────────────────────────────────────────────────────────
// DAILY MENUS
// ─────────────────────────────────────────────────────────

model DailyMenu {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime
  branchId  String?    @db.ObjectId
  status    MenuStatus @default(DRAFT)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  branch          Branch?         @relation(fields: [branchId], references: [id])
  items           MenuItem[]
  prepTasks       PrepTask[]
  deliveryBatches DeliveryBatch[]

  @@index([date])
  @@index([branchId])
  @@map("daily_menus")
}

// ─────────────────────────────────────────────────────────
// MENU ITEMS
// ─────────────────────────────────────────────────────────

model MenuItem {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  dailyMenuId    String   @db.ObjectId
  recipeId       String   @db.ObjectId
  mealType       MealType
  targetQuantity Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dailyMenu DailyMenu @relation(fields: [dailyMenuId], references: [id], onDelete: Cascade)
  recipe    Recipe    @relation(fields: [recipeId], references: [id])

  @@index([dailyMenuId])
  @@map("menu_items")
}

// ─────────────────────────────────────────────────────────
// PREP TASKS
// ─────────────────────────────────────────────────────────

model PrepTask {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  dailyMenuId  String         @db.ObjectId
  assignedToId String?        @db.ObjectId
  taskName     String
  status       PrepTaskStatus @default(TODO)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  dailyMenu  DailyMenu @relation(fields: [dailyMenuId], references: [id], onDelete: Cascade)
  assignedTo User?     @relation("PrepTaskAssignee", fields: [assignedToId], references: [id])

  @@index([dailyMenuId])
  @@index([assignedToId])
  @@map("prep_tasks")
}

// ─────────────────────────────────────────────────────────
// SUPPLIERS
// ─────────────────────────────────────────────────────────

model Supplier {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstin         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

// ─────────────────────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────────────────────

model InventoryItem {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  ingredientId  String   @db.ObjectId
  branchId      String?  @db.ObjectId
  currentStock  Float    @default(0)
  minStockLevel Float    @default(0)
  unit          String
  lastUpdatedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ingredient Ingredient      @relation(fields: [ingredientId], references: [id])
  branch     Branch?         @relation(fields: [branchId], references: [id])
  movements  StockMovement[]

  @@unique([ingredientId, branchId])
  @@index([ingredientId])
  @@index([branchId])
  @@map("inventory_items")
}

model StockMovement {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  inventoryItemId String            @db.ObjectId
  type            StockMovementType
  quantity        Float
  note            String?
  referenceId     String?           @db.ObjectId
  performedById   String?           @db.ObjectId
  createdAt       DateTime          @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  performedBy   User?         @relation("StockMovementPerformer", fields: [performedById], references: [id])

  @@index([inventoryItemId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────
// PURCHASE ORDERS
// ─────────────────────────────────────────────────────────

model PurchaseOrder {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  poNumber             String              @unique
  supplierId           String              @db.ObjectId
  branchId             String?             @db.ObjectId
  status               PurchaseOrderStatus @default(DRAFT)
  expectedDeliveryDate DateTime?
  totalAmount          Float               @default(0)
  notes                String?
  approvedById         String?             @db.ObjectId
  approvedAt           DateTime?
  createdById          String?             @db.ObjectId
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  branch     Branch?             @relation(fields: [branchId], references: [id])
  approvedBy User?               @relation("PurchaseOrderApprover", fields: [approvedById], references: [id])
  createdBy  User?               @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  items      PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  purchaseOrderId  String   @db.ObjectId
  ingredientId     String   @db.ObjectId
  quantity         Float
  unit             String
  unitPrice        Float
  totalPrice       Float
  receivedQuantity Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ─────────────────────────────────────────────────────────
// DELIVERY
// ─────────────────────────────────────────────────────────

model DeliveryBatch {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  batchNumber  String         @unique
  dailyMenuId  String?        @db.ObjectId
  branchId     String?        @db.ObjectId
  assignedToId String?        @db.ObjectId
  status       DeliveryStatus @default(PENDING)
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  dailyMenu  DailyMenu?     @relation(fields: [dailyMenuId], references: [id])
  branch     Branch?        @relation(fields: [branchId], references: [id])
  assignedTo User?          @relation("DeliveryBatchAgent", fields: [assignedToId], references: [id])
  stops      DeliveryStop[]

  @@index([dailyMenuId])
  @@index([status])
  @@index([scheduledAt])
  @@map("delivery_batches")
}

model DeliveryStop {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  deliveryBatchId String         @db.ObjectId
  customerName    String
  address         String
  phone           String?
  status          DeliveryStatus @default(PENDING)
  deliveredAt     DateTime?
  failureReason   String?
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  deliveryBatch DeliveryBatch @relation(fields: [deliveryBatchId], references: [id], onDelete: Cascade)

  @@index([deliveryBatchId])
  @@map("delivery_stops")
}

// ─────────────────────────────────────────────────────────
// BUSINESS - FINANCE, HR & PAYROLL ENUMS & MODELS
// ─────────────────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  SALARY
  INGREDIENT_PURCHASE
  RENT
  UTILITIES
  MARKETING
  CUSTOMER_BILLING
  OTHER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

model EmployeeProfile {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @unique @db.ObjectId
  designation       String
  department        String
  monthlySalary     Float
  joiningDate       DateTime
  bankName          String?
  bankAccountNumber String?
  ifscCode          String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payrolls PayrollRecord[]

  @@map("employee_profiles")
}

model PayrollRecord {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  employeeProfileId String        @db.ObjectId
  payPeriod         String // e.g. "2026-07"
  basicSalary       Float
  bonus             Float         @default(0)
  deductions        Float         @default(0)
  netSalary         Float
  status            PayrollStatus @default(DRAFT)
  paidAt            DateTime?
  transactionId     String?       @unique @db.ObjectId
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  transaction     Transaction?    @relation(fields: [transactionId], references: [id])

  @@unique([employeeProfileId, payPeriod])
  @@index([employeeProfileId])
  @@map("payroll_records")
}

model Transaction {
  id            String              @id @default(auto()) @map("_id") @db.ObjectId
  type          TransactionType
  category      TransactionCategory
  amount        Float
  status        TransactionStatus   @default(COMPLETED)
  referenceId   String?             @db.ObjectId
  notes         String?
  date          DateTime            @default(now())
  performedById String?             @db.ObjectId
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  performedBy   User?          @relation("TransactionPerformer", fields: [performedById], references: [id])
  payrollRecord PayrollRecord?

  @@index([type])
  @@index([category])
  @@index([date])
  @@map("transactions")
}

model SystemSetting {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value String

  @@map("system_settings")
}
